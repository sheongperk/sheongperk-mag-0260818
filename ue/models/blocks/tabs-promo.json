          "valueType": "string",
          "name": "image",
          "label": "Banner Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Banner Image Alt",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "link",
          "label": "CTA Link",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
